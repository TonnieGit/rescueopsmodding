---
// Annotated tutorial clip: muted, looping, autoplays like a GIF. Click to open full size.
interface Props {
	src: string;
	poster?: string;
	caption?: string;
}
const { src, poster, caption } = Astro.props;
---

<figure class="tut-clip not-content">
	<a href={src} target="_blank" rel="noopener" title="Open full size">
		<video src={src} poster={poster} autoplay loop muted playsinline preload="metadata"></video>
	</a>
	{caption && <figcaption>{caption} <a href={src} target="_blank" rel="noopener">Open full size</a></figcaption>}
</figure>

<style>
	.tut-clip {
		margin-block: 1.25rem;
	}
	.tut-clip video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		background: var(--sl-color-black);
	}
	.tut-clip figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.tut-clip figcaption a {
		color: var(--sl-color-accent-high);
	}
</style>
